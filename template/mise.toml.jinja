[tools]
node = "24.21.0"
"aqua:rhysd/actionlint" = "1.7.12"
editorconfig-checker = "4.0.2"
shfmt = "3.14.1"
zizmor = "1.32.0"
osv-scanner = "2.7.1"
"npm:lockfile-lint" = "5.1.0"
{%- if rust %}
cargo-deny = "0.20.2"
{%- endif %}
{%- if private %}
gitleaks = "8.30.1"
{%- endif %}

[env]
# Tasks run the tools the lockfile installed. A missing one fails, rather than npx fetching
# whatever package has its name.
{% raw %}_.path = ["{{config_root}}/node_modules/.bin"]{% endraw %}

# Each task is written as kit's formatter lays it out: a list that fits in a line stays on one.
[tasks.format]
{%- if rust %}
run = [
  "oxfmt --check -c node_modules/@tonalisk-labs/kit/rules/oxfmt.json",
  "shfmt --diff .",
  "cargo fmt --check",
]
{%- else %}
run = ["oxfmt --check -c node_modules/@tonalisk-labs/kit/rules/oxfmt.json", "shfmt --diff ."]
{%- endif %}

[tasks.lint]
{%- if rust %}
run = [
  "oxlint",
  "editorconfig-checker",
  "cargo clippy --all-targets",
  "cargo deny check",
  "kit-rust-lints",
]
{%- else %}
run = ["oxlint", "editorconfig-checker"]
{%- endif %}

{%- if not private %}

[tasks.workflows]
run = ["actionlint", "zizmor --offline --persona pedantic .github/workflows"]
{%- endif %}

# The npm tree's advisories, the registry's signature on every package, a lockfile that names only
# npm over HTTPS, and OSV's malware advisories and licences. The licences are those kit's deny.toml
# allows the crates, and the permissive ones npm adds; osv-scanner.toml lists the
# tools under other licences that no shipped file contains.
[tasks.audit]
run = [
  "npm audit --audit-level=info",
  "npm audit signatures",
  "lockfile-lint --path package-lock.json --allowed-hosts npm --validate-https",
  "osv-scanner scan source --config osv-scanner.toml --lockfile package-lock.json --licenses=MIT,Apache-2.0,BSD-2-Clause,BSD-3-Clause,ISC,Unicode-3.0,Zlib,CDLA-Permissive-2.0,0BSD,BlueOak-1.0.0,CC0-1.0,Python-2.0",
]

{%- if private %}

[tasks.secrets]
description = "No secret anywhere in the history or the working tree"
run = ["gitleaks git --no-banner --redact .", "gitleaks dir --no-banner --redact ."]

[tasks.pre-commit]
description = "No secret in what is about to be committed, as .githooks/pre-commit runs it"
run = "gitleaks git --pre-commit --staged --no-banner --redact ."

[tasks.hooks]
description = "Git runs the hooks in .githooks: gitleaks on each commit, the check on each push to main"
run = "git config core.hooksPath .githooks"

# A workflow added for a deploy brings actionlint and
# `zizmor --offline --persona pedantic .github/workflows` into the check.
[tasks.check]
description = "Every check, before each push to main"
depends = ["format", "lint", "audit", "secrets"]
{%- else %}

[tasks.check]
description = "Every check a pull request runs"
depends = ["format", "lint", "workflows", "audit"]
{%- endif %}
